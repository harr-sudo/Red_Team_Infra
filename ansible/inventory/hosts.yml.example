# Ansible Inventory Example
# This file should be generated from Terraform outputs or manually configured

all:
  children:
    c2_servers:
      hosts:
        c2-server-1:
          ansible_host: 1.2.3.4  # Replace with actual IP from Terraform output
          ansible_user: ec2-user
          ansible_ssh_private_key_file: ~/.ssh/red-team-keypair.pem
    
    redirectors:
      hosts:
        redirector-1:
          ansible_host: 5.6.7.8  # Replace with actual IP from Terraform output
          ansible_user: ec2-user
          ansible_ssh_private_key_file: ~/.ssh/red-team-keypair.pem
    
    all_servers:
      children:
        c2_servers:
        redirectors:

  vars:
    ansible_ssh_common_args: '-o StrictHostKeyChecking=no'
    ansible_python_interpreter: /usr/bin/python3

